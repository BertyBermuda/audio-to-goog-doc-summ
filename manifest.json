{
  "manifest_version": 3,
  "name": "Audio to Google Doc Summarizer",
  "description": "Send the audio file on the current page to your summarizer backend and open the resulting Google Doc.",
  "version": "1.0",
  "minimum_chrome_version": "116",

  "permissions": ["activeTab", "scripting", "storage", "alarms"],

  "host_permissions": [
    "https://your-domain.vercel.app/*",
    "https://*.supabase.co/*"
  ],

  "background": {
    "service_worker": "background.js",
    "type": "module"
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "Audio to Google Doc Summarizer"
  },

  "options_page": "options.html",

  "commands": {
    "run_summary": {
      "suggested_key": { "default": "Alt+D" },
      "description": "Upload audio and generate Executive Summary"
    }
  }
}
