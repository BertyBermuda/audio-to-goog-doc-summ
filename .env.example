# Supabase — Project Settings → API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Pabbly Connect catch webhook that does transcription + Doc creation
PABBLY_WEBHOOK_URL=https://connect.pabbly.com/workflow/sendwebhookdata/YOUR_WEBHOOK_ID

# Secret the extension sends as X-Extension-Secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTENSION_SHARED_SECRET=

# Separate secret Pabbly must echo back to /api/callback. Generate the same way.
PABBLY_CALLBACK_SECRET=

# Where Pabbly should call back. Vercel sets VERCEL_URL automatically, but that
# is the per-deployment URL — set this to your stable production domain.
PUBLIC_BASE_URL=https://your-domain.vercel.app
